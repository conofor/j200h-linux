#!/bin/sh
# wifi.start — runs inside Alpine's `local` service (local.d).
# Brings wlan0 up, starts wpa_supplicant (nl80211), waits for WPA,
# then runs DHCP. Everything is logged to /var/log/wifi-boot.log.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

(
	LOG=/var/log/wifi-boot.log
	say() { echo "$(date "+%H:%M:%S") $*" >> "$LOG" 2>/dev/null; sync; }
	say "wifi start"
	command -v rfkill >/dev/null 2>&1 && rfkill unblock all 2>/dev/null
	i=0
	while ! ip link show wlan0 >/dev/null 2>&1 && [ $i -lt 60 ]; do i=$((i+1)); sleep 1; done
	[ -z "$(ip link show wlan0 2>/dev/null)" ] && { say "NO wlan0"; sync; exit 0; }

	ip link set wlan0 up 2>>$LOG
	sleep 6
	mknod -m 666 /dev/urandom c 1 9 2>/dev/null
	mknod -m 666 /dev/random c 1 8 2>/dev/null
	mknod -m 666 /dev/null c 1 3 2>/dev/null
	mkdir -p /run/wpa_supplicant /run/sshd 2>/dev/null
	ip addr add 192.168.100.250/24 dev wlan0 2>>$LOG

	# NOTE: this wpa_supplicant build has NO -B and NO -f options.
	# Run it backgrounded with & and redirect output manually.
	wpa_supplicant -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf \
		-D nl80211 >>$LOG 2>&1 &
	say "supplicant pid $!"

	i=0
	while [ $i -lt 90 ]; do
		wpa_cli -i wlan0 status 2>/dev/null | grep -q "^wpa_state=COMPLETED" && break
		i=$((i+1)); sleep 1
	done
	STATE=$(wpa_cli -i wlan0 status 2>/dev/null | grep -E "wpa_state|ssid" | tr "\n" " ")
	say "wpa wait i=$i: $STATE"
	if echo "$STATE" | grep -q COMPLETED; then
		dhcpcd -b -t 20 wlan0 >>$LOG 2>&1
		say "dhcpcd: $(ip -4 addr show wlan0 | grep inet | tr "\n" " ")"
	else
		say "not connected"
	fi
	sync
) &
exit 0
