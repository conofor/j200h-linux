#!/bin/sh
# 00-devnodes.start — ensure static device nodes exist.
# Alpine's devfs/mdev may not create them; several daemons need them.
for spec in "null c 1 3" "zero c 1 5" "full c 1 7" "random c 1 8" "urandom c 1 9" "tty c 5 0"; do
	set -- $spec
	[ -e /dev/$1 ] || mknod -m 666 /dev/$1 $2 $3 $4 2>/dev/null
done
for t in 1 2 3 4 5 6; do
	[ -e /dev/tty$t ] || mknod -m 620 /dev/tty$t c 4 $t 2>/dev/null
done
mkdir -p /run/sshd /var/run/sshd 2>/dev/null
chmod 755 /run/sshd 2>/dev/null
exit 0
